<Window x:Class="CircuitoLivre.Views.LoadReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatório de cargas — Circuito Livre"
        Height="580" Width="1150" MinHeight="300" MinWidth="700"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Quadro:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="PanelCombo" Width="240" SelectionChanged="PanelCombo_SelectionChanged"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Selecionar no modelo" Padding="12,4" Margin="0,0,8,0" Click="Select_Click"/>
                <Button Content="Exportar CSV..." Padding="12,4" Margin="0,0,8,0" Click="Export_Click"/>
                <Button Content="Fechar" Padding="12,4" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="TotalsText" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <DataGrid x:Name="CircuitGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Quadro" Binding="{Binding Panel}" Width="*"/>
                <DataGridTextColumn Header="Circuito" Binding="{Binding Number}"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding LoadName}" Width="2*"/>
                <DataGridTextColumn Header="Tensão (V)" Binding="{Binding VoltageV, StringFormat=N0}"/>
                <DataGridTextColumn Header="Polos" Binding="{Binding Poles}"/>
                <DataGridTextColumn Header="Pot. aparente (VA)" Binding="{Binding ApparentLoadVA, StringFormat=N0}"/>
                <DataGridTextColumn Header="Pot. ativa (W)" Binding="{Binding TrueLoadW, StringFormat=N0}"/>
                <DataGridTextColumn Header="Corrente (A)" Binding="{Binding CurrentA, StringFormat=N2}"/>
                <DataGridTextColumn Header="Disjuntor (A)" Binding="{Binding RatingA, StringFormat=N0}"/>
                <DataGridTextColumn Header="Fiação" Binding="{Binding WireSize}"/>
                <DataGridTextColumn Header="Comprimento (m)" Binding="{Binding LengthM, StringFormat=N2}"/>
                <DataGridTextColumn Header="Elementos" Binding="{Binding ElementCount}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
