<Window x:Class="RafaelElectrical.Views.RenumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renumerar circuitos — RafaelElectrical"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14" MinWidth="440">
        <TextBlock x:Name="HeaderText" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <GroupBox Header="Ordem dos circuitos" Padding="8">
            <StackPanel>
                <RadioButton x:Name="CompactRadio" Content="Manter a ordem atual (só eliminar vagas vazias)" IsChecked="True" Margin="0,2"/>
                <RadioButton x:Name="NameRadio" Content="Pela descrição (A → Z)" Margin="0,2"/>
                <RadioButton x:Name="LoadRadio" Content="Pela carga (maior → menor)" Margin="0,2"/>
                <RadioButton x:Name="ClickRadio" Content="Na ordem em que eu clicar nos dispositivos" Margin="0,2"/>
                <RadioButton x:Name="SpacesRadio" Content="Na ordem em que eu clicar nos ambientes/espaços" Margin="0,2"/>
                <RadioButton x:Name="GeoRadio" Content="Pela posição na planta" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sentido na planta:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="GeoCombo" Grid.Column="1" SelectedIndex="0"
                      ToolTip="Usado na opção 'posição na planta' e para desempatar circuitos não clicados / do mesmo ambiente">
                <ComboBoxItem Content="Da esquerda para a direita, de cima para baixo"/>
                <ComboBoxItem Content="De cima para baixo, da esquerda para a direita"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Começar na posição:" VerticalAlignment="Center" Margin="0,8,8,0"/>
            <TextBox x:Name="StartBox" Grid.Row="1" Grid.Column="1" Text="1" Width="70" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </Grid>

        <TextBlock Margin="0,10,0,0" Foreground="Gray" TextWrapping="Wrap" MaxWidth="440"
                   Text="Circuitos travados no quadro não são movidos. Nas opções de clique, aperte ESC quando terminar."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Renumerar" Padding="14,4" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancelar" Padding="10,4" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
