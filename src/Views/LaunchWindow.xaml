<Window x:Class="RafaelElectrical.Views.LaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lançar pontos — RafaelElectrical"
        Height="560" Width="560" MinHeight="420" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="O que deseja lançar?" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,0">
                <RadioButton x:Name="LightRadio" Content="Luminárias" GroupName="cat" Margin="0,0,14,4" IsChecked="True" Checked="Category_Checked"/>
                <RadioButton x:Name="OutletRadio" Content="Tomadas" GroupName="cat" Margin="0,0,14,4" Checked="Category_Checked"/>
                <RadioButton x:Name="SwitchRadio" Content="Interruptores" GroupName="cat" Margin="0,0,14,4" Checked="Category_Checked"/>
                <RadioButton x:Name="TelecomRadio" Content="Telecom / dados" GroupName="cat" Margin="0,0,14,4" Checked="Category_Checked"/>
            </WrapPanel>
            <TextBox x:Name="SearchBox" Margin="0,6,0,0" TextChanged="SearchBox_TextChanged"
                     ToolTip="Filtrar por nome da família ou do tipo"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Altura (m):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="HeightBox" Grid.Column="1" ToolTip="Deixe em branco para manter a altura da família"/>
                <TextBlock Grid.Column="2" Text="Potência (VA):" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <TextBox x:Name="PowerBox" Grid.Column="3" ToolTip="Deixe em branco para manter a potência da família"/>
            </Grid>
            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Depois de clicar em Lançar, clique na planta (ou nas faces das paredes, inclusive do vínculo) para inserir quantos pontos quiser. ESC termina."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Lançar" Padding="16,4" Margin="0,0,6,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="Cancelar" Padding="10,4" IsCancel="True"/>
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="TypeList" Margin="0,8,0,0" DisplayMemberPath="Label" MouseDoubleClick="TypeList_MouseDoubleClick"/>
    </DockPanel>
</Window>
