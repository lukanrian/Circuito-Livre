<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2025/2026 rodam em .NET 8; Revit 2027 roda em .NET 10 -->
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>

    <AssemblyName>RafaelElectrical</AssemblyName>
    <RootNamespace>RafaelElectrical</RootNamespace>
    <Version>0.2.1</Version>
    <InformationalVersion>0.2.1-beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>Rafael Matias</Company>
    <Product>RafaelElectrical</Product>

    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <!-- avisos de conflito de versão vindos das DLLs do Revit (inofensivos) -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <OutputPath>$(MSBuildThisFileDirectory)..\build\bin\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <!-- Referências fixas por versão; nenhuma DLL da API é distribuída com o plugin. -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Autodesk.Revit.Sdk.Refs.2025" Version="1.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Autodesk.Revit.Sdk.Refs.2026" Version="1.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2027'">
    <PackageReference Include="Autodesk.Revit.Sdk.Refs.2027" Version="2.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" LogicalName="RafaelElectrical.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
